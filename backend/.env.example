# ──────────────────────────────────────────
# LMS Training App — Backend Configuration
# ──────────────────────────────────────────

# App
APP_NAME=LMS Training Portal
APP_VERSION=1.0.0
DEBUG=true

# Database — SQLite (out of the box)
DATABASE_URL=sqlite:///./lms_training.db

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (OTP storage + Celery broker)
REDIS_URL=redis://localhost:6379/0

# OTP
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=3

# SMS Gateway (MSG91)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=LMSAPP
MSG91_TEMPLATE_ID=your-template-id

# AWS
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=ap-south-1
AWS_S3_BUCKET=lms-training-assets
AWS_REKOGNITION_COLLECTION=lms-faces

# SendGrid
SENDGRID_API_KEY=your-sendgrid-key
SENDGRID_FROM_EMAIL=noreply@training.company.com

# Firebase FCM
FCM_SERVER_KEY=your-fcm-server-key

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]
